NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/gst_invoice_company_dev
MONGODB_DB_NAME=gst_invoice_company_dev
MONGODB_IP_FAMILY=4
CLIENT_ORIGIN=http://localhost:5173
COMPANY_APP_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5050/api

# Company service security
# All environments require secure authentication and dedicated 32+ character secrets.
AUTH_REQUIRED=true
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Losing this key makes encrypted invoice/profile data unrecoverable.
DATA_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
INVITATION_TOKEN_SECRET=replace-with-a-dedicated-32-character-secret
PASSWORD_RESET_SECRET=replace-with-a-dedicated-32-character-secret
ADMIN_INTERNAL_SHARED_SECRET=replace-with-a-dedicated-32-character-secret
SESSION_TTL_MINUTES=480
SESSION_IDLE_TTL_MINUTES=60
TRUST_PROXY=false
COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
ALLOW_DATABASE_RESET=false
REQUEST_BODY_LIMIT=2mb

# Company invitation and password-recovery email.
# Render Free blocks SMTP ports 25, 465, and 587; use a TLS-capable relay on 2525 there.
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM=GST Invoice Generator <no-reply@example.com>
SMTP_SECURE=false

# Optional company-owned Gmail send-only authorization (COMPANY service only).
# Create a dedicated Google Web application OAuth client and enable Gmail API.
# Add this exact redirect URI in Google: <COMPANY_APP_ORIGIN>/email-connect
# Uncomment BOTH after supplying real values. Never use VITE_ for these secrets.
# GOOGLE_EMAIL_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_EMAIL_CLIENT_SECRET=your-google-client-secret
# Custom-domain Brevo API keys belong to individual companies and are entered
# in Company Profile > Company Email, not in this shared environment file.

# Optional WhatsApp Business Cloud API delivery. Leave every value empty to disable.
# Use long-lived production credentials and approved utility templates. Never expose
# WHATSAPP_ACCESS_TOKEN through VITE_ variables or commit it to Git.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_RECEIPT=
WHATSAPP_TEMPLATE_CANCELLATION=
WHATSAPP_TEMPLATE_LANGUAGE=en
